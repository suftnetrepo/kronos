{
  "expo": {
    "name": "Kronos",
    "slug": "kronos",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F7"
    },
    "androidStatusBar": {
      "backgroundColor": "#F5F5F7",
      "barStyle": "dark-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kronos.timetable",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kronos uses Face ID to keep your timetable secure.",
        "NSCameraUsageDescription": "Kronos uses the camera to scan timetable QR codes.",
        "NSPhotoLibraryUsageDescription": "Kronos saves timetable QR codes to your photo library.",
        "NSDocumentsFolderUsageDescription": "Kronos reads timetable files you choose to import.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Kronos uses your local network during development to connect to the Metro bundler on your computer. This code path doesn't run in release builds.",
        "NSBonjourServices": [
          "_dev._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.kronos.timetable",
      "versionCode": 6,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withFmtConstevalFix.js",
      "./plugins/withAndroidReleaseSigning.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "sounds": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kronos uses Face ID to keep your timetable secure."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "scheme": "kronos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f32dc322-a960-4299-b460-f42aad5e45f0"
      }
    },
    "owner": "kcmkcms"
  }
}
